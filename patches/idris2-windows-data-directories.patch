+quoteRefCArg : String -> String
+quoteRefCArg arg =
+  if any (\c => c == ' ' || c == '\t') (unpack arg)
+     then "\"" ++ arg ++ "\""
+     else arg
+
+refCCmd : List String -> String
+refCCmd = unwords . map quoteRefCArg
