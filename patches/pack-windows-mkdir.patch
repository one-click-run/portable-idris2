diff --git a/src/Pack/Core/IO.idr b/src/Pack/Core/IO.idr
index e359ded..9fce120 100644
--- a/src/Pack/Core/IO.idr
+++ b/src/Pack/Core/IO.idr
@@ -194,7 +194,10 @@ fileMissing = map not . fileExists
 ||| Tries to create a director (including parent directories)
 export
 mkDir : HasIO io => (dir : Path Abs) -> EitherT PackErr io ()
 mkDir (PAbs _ [<]) = pure ()
-mkDir d            = sys ["mkdir", "-p", d]
+-- This Pack build targets native Windows. Run mkdir through MSYS2's external
+-- env.exe so cmd.exe cannot intercept it as a built-in command. The GNU tool
+-- supports `-p` and Pack's drive-letter paths containing forward slashes.
+mkDir d            = sys ["env.exe", "mkdir", "-p", d]
 
 ||| Creates a parent directory of a (file) path
 export
diff --git a/src/Pack/Core/Git.idr b/src/Pack/Core/Git.idr
index f48cda3..1de9f58 100644
--- a/src/Pack/Core/Git.idr
+++ b/src/Pack/Core/Git.idr
@@ -21,7 +21,11 @@ parameters {auto has : HasIO io}
 
   ||| Clones a Git repository to the given destination
   cloneRemote : (url : URL) -> (dest : Path Abs) -> EitherT PackErr io ()
-  cloneRemote url dest = sys ["git", "clone", "--depth", "1", "-q", url, dest]
+  cloneRemote url dest = do
+    -- Windows path normalization can leave the intended clone destination
+    -- behind while creating its parent. Git requires it to be absent.
+    rmDir dest
+    sys ["git", "clone", "--depth", "1", "-q", url, dest]
 
   ||| Creates a shared clone of a cached local git clone
   cloneShared :
