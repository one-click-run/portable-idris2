diff --git a/src/Pack/Core/IO.idr b/src/Pack/Core/IO.idr
index e359ded..0ed5f6d 100644
--- a/src/Pack/Core/IO.idr
+++ b/src/Pack/Core/IO.idr
@@ -171,14 +171,17 @@ sysRunWithEnv cmd env = do
 --------------------------------------------------------------------------------
 
 ||| Checks if a file at the given location exists.
+pathExists : HasIO io => String -> io Bool
+pathExists path = System.File.Meta.exists (replace "/" "\\" path)
+
 export %inline
 exists : HasIO io => (dir : Path Abs) -> io Bool
-exists = exists . interpolate
+exists = pathExists . interpolate
 
 ||| Checks if a file at the given location exists.
 export %inline
 fileExists : HasIO io => (f : File Abs) -> io Bool
-fileExists = exists . interpolate
+fileExists = pathExists . interpolate
 
 ||| Checks if a file at the given location is missing.
 export
@@ -194,7 +199,10 @@ fileMissing = map not . fileExists
 ||| Tries to create a director (including parent directories)
 export
 mkDir : HasIO io => (dir : Path Abs) -> EitherT PackErr io ()
 mkDir (PAbs _ [<]) = pure ()
-mkDir d            = sys ["mkdir", "-p", d]
+-- This Pack build targets native Windows. Run mkdir through MSYS2's external
+-- env.exe so cmd.exe cannot intercept it as a built-in command. The GNU tool
+-- supports `-p` and Pack's drive-letter paths containing forward slashes.
+mkDir d            = sys ["env.exe", "mkdir", "-p", d]
 
 ||| Creates a parent directory of a (file) path
 export
diff --git a/src/Pack/Core/Git.idr b/src/Pack/Core/Git.idr
index f48cda3..a6c8ee3 100644
--- a/src/Pack/Core/Git.idr
+++ b/src/Pack/Core/Git.idr
@@ -21,7 +21,11 @@ parameters {auto has : HasIO io}
 
   ||| Clones a Git repository to the given destination
   cloneRemote : (url : URL) -> (dest : Path Abs) -> EitherT PackErr io ()
-  cloneRemote url dest = sys ["git", "clone", "--depth", "1", "-q", url, dest]
+  cloneRemote url dest = do
+    -- Windows can report a false negative for mixed-separator paths. This
+    -- branch is rebuilding the cache, so remove the destination unconditionally.
+    sys ["env.exe", "rm", "-rf", dest]
+    sys ["git", "clone", "--depth", "1", "-q", url, dest]
 
   ||| Creates a shared clone of a cached local git clone
   cloneShared :
@@ -33,7 +37,9 @@ parameters {auto has : HasIO io}
   cloneShared url pkg =
     let cache := gitCacheDir url
         tmp   := gitTmpDir pkg
-     in sys ["git", "clone", "--shared", "-q", cache, tmp]
+     in do
+       sys ["env.exe", "rm", "-rf", tmp]
+       sys ["git", "clone", "--shared", "-q", cache, tmp]
 
   ||| Fetch the given commit from upstream
   fetch : (commit : Commit) -> EitherT PackErr io ()
